<mxfile host="app.diagrams.net" modified="2026-07-28T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="overview" name="01-业务全景">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ov-title" value="博格华纳（宁波）新产品开发管理｜业务流程全景" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#16324F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="40" as="geometry"/></mxCell>
        <mxCell id="ov-note" value="核心原则：项目开发与子零件开发是两个相互独立的业务模块；子零件进度只作风险提醒，不构成项目 Gate 硬阻塞。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F59E0B;fontColor=#7C4A03;fontSize=14;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1710" height="52" as="geometry"/></mxCell>

        <mxCell id="ov-project-bg" value="项目开发模块（PM 主导 Gate 流转）" style="swimlane;html=1;horizontal=1;startSize=36;rounded=1;fillColor=#EAF3FF;swimlaneFillColor=#F7FAFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1710" height="260" as="geometry"/></mxCell>
        <mxCell id="ov-start" value="开始" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#16324F;strokeColor=#16324F;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="250" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="ov-cko" value="CKO&#xa;销售创建项目&#xa;完成默认任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="225" width="150" height="110" as="geometry"/></mxCell>
        <mxCell id="ov-pko" value="PKO&#xa;启动会 / 团队&#xa;关键节点 / 流程分支" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="365" y="225" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="ov-bom" value="L1 BOM&#xa;AE 创建编辑&#xa;SCM 确认锁定生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="575" y="225" width="175" height="110" as="geometry"/></mxCell>
        <mxCell id="ov-g1" value="Gate1&#xa;PM 创建 L1 总成 APQP&#xa;默认负责人 AQE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="225" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="ov-g26" value="Gate2 ～ Gate6&#xa;任务执行 → 准入检查&#xa;审批 → 进入下一 Gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="225" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="ov-ho" value="Hand Over&#xa;PM 登记交接信息&#xa;完成闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="225" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="ov-end" value="结束" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#16324F;strokeColor=#16324F;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1505" y="250" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="ov-flow-note" value="标准流程：Gate1–Gate6　｜　简化流程：Gate1–Gate3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#818CF8;fontColor=#3730A3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="790" y="355" width="450" height="36" as="geometry"/></mxCell>

        <mxCell id="ov-sub-bg" value="子零件开发模块（SQD 主导零件 + 供应商方案开发）" style="swimlane;html=1;horizontal=1;startSize=36;rounded=1;fillColor=#ECFDF5;swimlaneFillColor=#F7FFFB;strokeColor=#10B981;fontColor=#134E4A;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1710" height="270" as="geometry"/></mxCell>
        <mxCell id="ov-src1" value="来源 A&#xa;已确认 L1 BOM&#xa;BOM 行 + 供应方案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#134E4A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="535" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="ov-src2" value="来源 B&#xa;授权人员手动新增&#xa;可关联项目或独立管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#134E4A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="640" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="ov-decision" value="是否需要开发 /&#xa;是否生成 APQP？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#134E4A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="365" y="535" width="165" height="120" as="geometry"/></mxCell>
        <mxCell id="ov-task" value="生成子零件开发任务&#xa;粒度：零件 + 供应商方案&#xa;默认负责人：SQD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#134E4A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="535" width="215" height="120" as="geometry"/></mxCell>
        <mxCell id="ov-subgate" value="子零件自身阶段 / Gate&#xa;供应商开发、APQP、资料、问题&#xa;独立状态与追溯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#134E4A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="535" width="245" height="120" as="geometry"/></mxCell>
        <mxCell id="ov-risk" value="向项目侧提供风险摘要&#xa;未启动 / 延期 / 待影响分析 / 供应商风险&#xa;仅提醒、协同和人工判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#7C2D12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="535" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="ov-noblock" value="不阻塞项目 Gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1570" y="570" width="145" height="50" as="geometry"/></mxCell>

        <mxCell id="ov-legend" value="跨模块关联：项目/BOM/APQP 页面可展示子零件任务号并跳转详情；关联用于信息共享、风险提醒和追溯，不合并两个模块的完成条件。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1710" height="55" as="geometry"/></mxCell>

        <mxCell id="ov-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ov-start" target="ov-cko"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ov-cko" target="ov-pko"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ov-pko" target="ov-bom"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ov-bom" target="ov-g1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ov-g1" target="ov-g26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ov-g26" target="ov-ho"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ov-ho" target="ov-end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ov-src1" target="ov-decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ov-src2" target="ov-decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e10" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;fontColor=#047857;" edge="1" parent="1" source="ov-decision" target="ov-task"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ov-task" target="ov-subgate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#F97316;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ov-subgate" target="ov-risk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ov-risk" target="ov-noblock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e14" value="关联/拆解" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=6 6;strokeColor=#10B981;strokeWidth=2;endArrow=block;fontColor=#047857;" edge="1" parent="1" source="ov-g1" target="ov-src1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov-e15" value="风险摘要（非阻塞）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=6 6;strokeColor=#F97316;strokeWidth=2;endArrow=block;fontColor=#C2410C;" edge="1" parent="1" source="ov-risk" target="ov-g26"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="project-flow" name="02-项目主流程">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="p0"/>
        <mxCell id="p1" parent="p0"/>
        <mxCell id="p-title" value="项目开发主流程｜角色泳道" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#16324F;" vertex="1" parent="p1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="p-stage" value="阶段" style="swimlane;html=1;horizontal=0;startSize=110;fillColor=#16324F;swimlaneFillColor=#F8FAFC;strokeColor=#64748B;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="40" y="90" width="1800" height="95" as="geometry"/></mxCell>
        <mxCell id="p-s-cko" value="CKO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontStyle=1;fontColor=#16324F;" vertex="1" parent="p1"><mxGeometry x="170" y="115" width="180" height="45" as="geometry"/></mxCell>
        <mxCell id="p-s-pko" value="PKO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontStyle=1;fontColor=#16324F;" vertex="1" parent="p1"><mxGeometry x="390" y="115" width="340" height="45" as="geometry"/></mxCell>
        <mxCell id="p-s-g1" value="Gate1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontStyle=1;fontColor=#16324F;" vertex="1" parent="p1"><mxGeometry x="770" y="115" width="220" height="45" as="geometry"/></mxCell>
        <mxCell id="p-s-g26" value="Gate2 ～ Gate6（简化流程到 Gate3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontStyle=1;fontColor=#16324F;" vertex="1" parent="p1"><mxGeometry x="1030" y="115" width="500" height="45" as="geometry"/></mxCell>
        <mxCell id="p-s-ho" value="Hand Over" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontStyle=1;fontColor=#16324F;" vertex="1" parent="p1"><mxGeometry x="1570" y="115" width="210" height="45" as="geometry"/></mxCell>

        <mxCell id="p-sales-lane" value="销售" style="swimlane;html=1;horizontal=0;startSize=110;fillColor=#EAF3FF;swimlaneFillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="40" y="185" width="1800" height="135" as="geometry"/></mxCell>
        <mxCell id="p-sales-create" value="创建开发项目" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="170" y="220" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="p-sales-cko" value="完成 CKO 任务并提交" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="390" y="220" width="190" height="60" as="geometry"/></mxCell>

        <mxCell id="p-pm-lane" value="PM" style="swimlane;html=1;horizontal=0;startSize=110;fillColor=#EAF3FF;swimlaneFillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="40" y="320" width="1800" height="220" as="geometry"/></mxCell>
        <mxCell id="p-pko-meeting" value="发起 PKO 启动会&#xa;组织 Gate1～6 团队" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="390" y="355" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="p-milestone" value="维护客户 / BW 内部节点&#xa;内部 OTS=G4，PPAP=G5，SOP=G6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;" vertex="1" parent="p1"><mxGeometry x="600" y="355" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="p-branch" value="判定流程分支" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="885" y="345" width="155" height="95" as="geometry"/></mxCell>
        <mxCell id="p-pm-apqp" value="基于已锁定 L1 BOM&#xa;创建 L1 总成 APQP&#xa;指定负责人（默认 AQE）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="770" y="445" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="p-pm-assign" value="分配当前 Gate 项目级任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="1060" y="355" width="220" height="65" as="geometry"/></mxCell>
        <mxCell id="p-pm-check" value="发起 Gate 准入检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="1310" y="355" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="p-pm-approve" value="组织审批&#xa;通过 / 条件通过 / 驳回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="1310" y="445" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="p-pm-ho" value="手动触发 Hand Over&#xa;登记交接信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="1580" y="385" width="190" height="78" as="geometry"/></mxCell>

        <mxCell id="p-ae-lane" value="AE" style="swimlane;html=1;horizontal=0;startSize=110;fillColor=#EAF3FF;swimlaneFillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="40" y="540" width="1800" height="135" as="geometry"/></mxCell>
        <mxCell id="p-ae-bom" value="按 L1 总成创建 / 编辑 BOM&#xa;形成最新工作版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="510" y="575" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="p-ae-submit" value="提交待确认版本至 SCM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="770" y="575" width="220" height="70" as="geometry"/></mxCell>

        <mxCell id="p-scm-lane" value="SCM" style="swimlane;html=1;horizontal=0;startSize=110;fillColor=#EAF3FF;swimlaneFillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="40" y="675" width="1800" height="135" as="geometry"/></mxCell>
        <mxCell id="p-scm-confirm" value="确认 / 编辑选中的 L1 BOM&#xa;锁定生效并回传 PM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="770" y="710" width="260" height="70" as="geometry"/></mxCell>

        <mxCell id="p-team-lane" value="各职能团队" style="swimlane;html=1;horizontal=0;startSize=110;fillColor=#EAF3FF;swimlaneFillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="40" y="810" width="1800" height="135" as="geometry"/></mxCell>
        <mxCell id="p-team-do" value="接收并执行当前 Gate 项目级任务&#xa;反馈完成情况与交付物" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="1060" y="845" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="p-team-review" value="参与 Gate 评审&#xa;闭环整改 / 条件项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="1360" y="845" width="210" height="70" as="geometry"/></mxCell>

        <mxCell id="p-rule" value="Gate 准入只检查：项目级 Gate 任务、项目级必需输入、L1 总成 APQP、项目审批/整改闭环、影响当前 Gate 审批依据的 L1 BOM。子零件任务状态不在硬阻塞清单中。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F59E0B;fontColor=#7C4A03;fontSize=14;align=left;spacingLeft=14;" vertex="1" parent="p1"><mxGeometry x="40" y="985" width="1800" height="65" as="geometry"/></mxCell>

        <mxCell id="p-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="p1" source="p-sales-create" target="p-sales-cko"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="p1" source="p-sales-cko" target="p-pko-meeting"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="p1" source="p-pko-meeting" target="p-milestone"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="p1" source="p-milestone" target="p-branch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e5" value="分配 BOM 待办" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;fontColor=#1D4ED8;" edge="1" parent="p1" source="p-branch" target="p-ae-bom"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="p1" source="p-ae-bom" target="p-ae-submit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="p1" source="p-ae-submit" target="p-scm-confirm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="p1" source="p-scm-confirm" target="p-pm-apqp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="p1" source="p-pm-apqp" target="p-pm-assign"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="p1" source="p-pm-assign" target="p-team-do"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e11" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="p1" source="p-team-do" target="p-pm-check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e12" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="p1" source="p-pm-check" target="p-pm-approve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e13" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="p1" source="p-pm-approve" target="p-team-review"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e14" value="下一 Gate（循环）" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#2563EB;strokeWidth=2;endArrow=block;fontColor=#1D4ED8;" edge="1" parent="p1" source="p-team-review" target="p-pm-assign"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1465" y="950"/><mxPoint x="1170" y="950"/></Array></mxGeometry></mxCell>
        <mxCell id="p-e15" value="所有适用 Gate 完成" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;fontColor=#1D4ED8;" edge="1" parent="p1" source="p-pm-approve" target="p-pm-ho"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="bom-apqp" name="03-BOM_APQP_供应方案">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="b0"/>
        <mxCell id="b1" parent="b0"/>
        <mxCell id="b-title" value="BOM、L1 APQP、供应方案与子零件开发任务联动" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#16324F;" vertex="1" parent="b1"><mxGeometry x="40" y="20" width="1250" height="40" as="geometry"/></mxCell>
        <mxCell id="b-container" value="项目 BOM 容器&#xa;仅表示项目下有哪些 L1 总成&#xa;不承载项目整体正式版本号" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EAF3FF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="60" y="120" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="b-l1a" value="L1 总成 A&#xa;独立版本链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="340" y="95" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="b-l1b" value="L1 总成 B&#xa;独立版本链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="340" y="190" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="b-draft" value="草稿版本&#xa;AE 编辑中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;" vertex="1" parent="b1"><mxGeometry x="600" y="95" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="b-pending" value="待确认版本&#xa;等待 SCM 确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;" vertex="1" parent="b1"><mxGeometry x="800" y="95" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="b-locked" value="已锁定生效版本&#xa;同一 L1 同时仅一个&#xa;例：PKO_V1.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="1020" y="85" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="b-history" value="旧版本保留&#xa;已作废 / 已冻结&#xa;不得物理覆盖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="b1"><mxGeometry x="1020" y="205" width="190" height="85" as="geometry"/></mxCell>
        <mxCell id="b-edit-again" value="再次编辑：从当前生效版本复制&#xa;生成下一工作版本（如 PKO_V2.0）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="b1"><mxGeometry x="600" y="205" width="370" height="70" as="geometry"/></mxCell>

        <mxCell id="b-l1-apqp" value="PM 创建 L1 总成 APQP&#xa;必须基于具体 L1 生效版本&#xa;sourceBomVersionId&#xa;负责人默认 AQE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="1300" y="80" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="b-lines" value="BOM 行完整层级&#xa;L1 总成 / 子总成 / 子零件&#xa;零件、数量、父级、是否共用件、是否需 APQP、起始 Gate、变更状态…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#16324F;" vertex="1" parent="b1"><mxGeometry x="1300" y="235" width="300" height="125" as="geometry"/></mxCell>

        <mxCell id="b-evaluate" value="逐 BOM 行评估&#xa;是否新开发 / 关键件 / 共用件？&#xa;是否需要 APQP 或零件开发任务？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#134E4A;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="650" y="400" width="245" height="150" as="geometry"/></mxCell>
        <mxCell id="b-supply" value="配置 BOM 行下的供应方案&#xa;供应商 / 一供二供 / 策略 / 是否开发&#xa;是否生成 APQP / 起始 Gate / 默认负责人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#134E4A;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="980" y="410" width="300" height="130" as="geometry"/></mxCell>

        <mxCell id="b-single" value="单一供应&#xa;仅一供参与开发&#xa;默认生成一供任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#134E4A;" vertex="1" parent="b1"><mxGeometry x="120" y="650" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="b-record" value="双供备案&#xa;二供仅备案&#xa;不生成 APQP / 不影响项目 Gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#134E4A;" vertex="1" parent="b1"><mxGeometry x="400" y="650" width="240" height="95" as="geometry"/></mxCell>
        <mxCell id="b-dual" value="双供同步开发&#xa;一供、二供均生成独立任务&#xa;重点跟踪但不影响项目 Gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#134E4A;" vertex="1" parent="b1"><mxGeometry x="700" y="650" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="b-later" value="二供后续导入&#xa;指定 Gate / 条件后启动&#xa;启动前备案，启动后按任务管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#134E4A;" vertex="1" parent="b1"><mxGeometry x="1010" y="650" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="b-create-task" value="创建子零件开发任务&#xa;唯一粒度：零件 + 供应商方案&#xa;记录 sourceBomLineId / sourceSupplyPlanId&#xa;默认负责人 SQD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#134E4A;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="1330" y="620" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="b-manual" value="手动新增通道&#xa;客户临时要求 / 供应商导入 / 试制验证 / 售后等&#xa;可关联项目，也可独立管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#7C2D12;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="1330" y="805" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="b-link" value="项目 BOM / 项目 APQP 页面&#xa;仅当已有关联任务时显示任务号并可跳转详情&#xa;子零件 APQP 不并入项目 Gate 完成条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F59E0B;fontColor=#7C4A03;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="600" y="835" width="530" height="95" as="geometry"/></mxCell>

        <mxCell id="b-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="b1" source="b-container" target="b-l1a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="b1" source="b-container" target="b-l1b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="b1" source="b-l1a" target="b-draft"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="b1" source="b-draft" target="b-pending"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e5" value="SCM 确认" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;fontColor=#1D4ED8;" edge="1" parent="b1" source="b-pending" target="b-locked"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e6" value="替代后留痕" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#64748B;endArrow=block;fontColor=#475569;" edge="1" parent="b1" source="b-locked" target="b-history"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e7" value="复制" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#64748B;endArrow=block;fontColor=#475569;" edge="1" parent="b1" source="b-locked" target="b-edit-again"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#64748B;endArrow=block;" edge="1" parent="b1" source="b-edit-again" target="b-pending"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e9" value="创建依据" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;fontColor=#1D4ED8;" edge="1" parent="b1" source="b-locked" target="b-l1-apqp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e10" value="包含" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;fontColor=#1D4ED8;" edge="1" parent="b1" source="b-locked" target="b-lines"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e11" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;" edge="1" parent="b1" source="b-lines" target="b-evaluate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e12" value="需要" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;fontColor=#047857;" edge="1" parent="b1" source="b-evaluate" target="b-supply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e13" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;endArrow=block;" edge="1" parent="b1" source="b-supply" target="b-single"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e14" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;endArrow=block;" edge="1" parent="b1" source="b-supply" target="b-record"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e15" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;endArrow=block;" edge="1" parent="b1" source="b-supply" target="b-dual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e16" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;endArrow=block;" edge="1" parent="b1" source="b-supply" target="b-later"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e17" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;" edge="1" parent="b1" source="b-single" target="b-create-task"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e18" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;" edge="1" parent="b1" source="b-dual" target="b-create-task"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e19" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;" edge="1" parent="b1" source="b-later" target="b-create-task"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e20" value="另一创建来源" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#F97316;strokeWidth=2;endArrow=block;fontColor=#C2410C;" edge="1" parent="b1" source="b-manual" target="b-create-task"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e21" value="摘要 / 跳转" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;fontColor=#B45309;" edge="1" parent="b1" source="b-create-task" target="b-link"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="gate-check" name="04-项目Gate准入">
    <mxGraphModel dx="1700" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="g0"/>
        <mxCell id="g1" parent="g0"/>
        <mxCell id="g-title" value="项目 Gate 提交审批｜准入判断与风险提醒边界" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#16324F;" vertex="1" parent="g1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="g-start" value="PM 发起当前 Gate&#xa;提交审批" style="ellipse;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=#16324F;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="80" y="170" width="150" height="90" as="geometry"/></mxCell>
        <mxCell id="g-c1" value="项目自身当前 Gate&#xa;任务是否全部完成？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="300" y="145" width="210" height="140" as="geometry"/></mxCell>
        <mxCell id="g-c2" value="项目级必需输入是否完成？&#xa;关键节点 / 成员 / 项目 APQP / L1 APQP 等" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="590" y="135" width="240" height="160" as="geometry"/></mxCell>
        <mxCell id="g-c3" value="审批、驳回整改、&#xa;条件通过事项是否闭环？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="910" y="145" width="220" height="140" as="geometry"/></mxCell>
        <mxCell id="g-c4" value="涉及当前 Gate 的 L1 BOM&#xa;是否满足项目审批依据？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="1210" y="145" width="220" height="140" as="geometry"/></mxCell>
        <mxCell id="g-pass" value="允许提交 Gate 审批" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#065F46;fontStyle=1;fontSize=16;" vertex="1" parent="g1"><mxGeometry x="1510" y="175" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="g-block" value="阻塞提交&#xa;明确显示未满足的项目级条件和待处理对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="650" y="390" width="330" height="90" as="geometry"/></mxCell>

        <mxCell id="g-bom-title" value="L1 BOM 默认阻塞场景（仅限影响项目级审批依据）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;fontSize=15;" vertex="1" parent="g1"><mxGeometry x="70" y="555" width="760" height="45" as="geometry"/></mxCell>
        <mxCell id="g-bom-list" value="• 涉及当前 Gate 的 L1 总成尚无已锁定生效 BOM&#xa;• 草稿或待 SCM 确认版本被标记为影响当前 Gate 审批依据&#xa;• 变更导致 L1 APQP、项目范围、关键节点或客户交付承诺无法确认&#xa;• PM / 审批人明确标记为项目级阻塞且原因未关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#FCA5A5;fontColor=#7F1D1D;align=left;verticalAlign=top;spacing=14;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="70" y="610" width="760" height="170" as="geometry"/></mxCell>

        <mxCell id="g-risk-title" value="子零件风险摘要（展示，但绝不作为 Gate 硬阻塞）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F59E0B;fontColor=#7C4A03;fontStyle=1;fontSize=15;" vertex="1" parent="g1"><mxGeometry x="900" y="555" width="820" height="45" as="geometry"/></mxCell>
        <mxCell id="g-risk-list" value="可展示：未创建 / 未启动 / 进行中 / 延期 / 待影响分析 / 供应商风险 / 子零件 APQP 未关闭。&#xa;&#xa;用途：风险提醒、跨模块协同、资料追溯、项目团队人工判断。&#xa;&#xa;禁止文案：不得称为“项目 Gate 阻塞原因”，不得要求全部完成后才允许项目提交。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;align=left;verticalAlign=top;spacing=14;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="900" y="610" width="820" height="170" as="geometry"/></mxCell>
        <mxCell id="g-manual" value="审批团队结合风险、交付承诺、客户要求和审批意见进行人工判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#818CF8;fontColor=#3730A3;fontStyle=1;fontSize=15;" vertex="1" parent="g1"><mxGeometry x="1020" y="840" width="590" height="65" as="geometry"/></mxCell>

        <mxCell id="g-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="g1" source="g-start" target="g-c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e2" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;fontColor=#1D4ED8;" edge="1" parent="g1" source="g-c1" target="g-c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e3" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;fontColor=#1D4ED8;" edge="1" parent="g1" source="g-c2" target="g-c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e4" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;fontColor=#1D4ED8;" edge="1" parent="g1" source="g-c3" target="g-c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e5" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;fontColor=#047857;" edge="1" parent="g1" source="g-c4" target="g-pass"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e6" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=block;fontColor=#B91C1C;" edge="1" parent="g1" source="g-c1" target="g-block"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e7" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=block;fontColor=#B91C1C;" edge="1" parent="g1" source="g-c2" target="g-block"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e8" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=block;fontColor=#B91C1C;" edge="1" parent="g1" source="g-c3" target="g-block"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e9" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=block;fontColor=#B91C1C;" edge="1" parent="g1" source="g-c4" target="g-block"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e10" value="审批前并行展示" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;fontColor=#B45309;" edge="1" parent="g1" source="g-risk-list" target="g-manual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e11" value="人工判断" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#818CF8;strokeWidth=2;endArrow=block;fontColor=#4F46E5;" edge="1" parent="g1" source="g-manual" target="g-pass"><mxGeometry relative="1" as="geometry"/></mxCell>
