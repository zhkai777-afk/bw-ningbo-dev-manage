  <diagram id="bom-change" name="05-BOM变更与追溯">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="c0"/>
        <mxCell id="c1" parent="c0"/>
        <mxCell id="c-title" value="BOM 变更、影响分析、任务同步与全链路追溯" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#16324F;" vertex="1" parent="c1"><mxGeometry x="40" y="20" width="1250" height="40" as="geometry"/></mxCell>
        <mxCell id="c-trigger" value="已生效 L1 BOM&#xa;发生变更" style="ellipse;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=#16324F;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="80" y="145" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="c-new-version" value="从当前生效版本复制&#xa;生成该 L1 下一工作版本&#xa;其他 L1 不同步升版" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="310" y="135" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="c-diff" value="版本差异识别" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="630" y="150" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="c-types" value="新增 / 删除 / 替换 / 数量 / 层级 / 规格图纸&#xa;一供变更 / 二供新增删除 / 策略变化 / 供应商升降级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="880" y="135" width="410" height="110" as="geometry"/></mxCell>
        <mxCell id="c-impact" value="执行影响分析" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="1370" y="130" width="210" height="120" as="geometry"/></mxCell>

        <mxCell id="c-project-q" value="是否影响项目 Gate 必需输入、&#xa;L1 总成 APQP、项目范围、关键节点、&#xa;客户承诺或审批依据？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="250" y="380" width="280" height="170" as="geometry"/></mxCell>
        <mxCell id="c-project-block" value="项目级影响&#xa;可标记为项目 Gate 阻塞&#xa;明确原因、责任人和关闭条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="80" y="650" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="c-sub-only" value="仅影响子零件 / 供应商开发&#xa;不阻塞项目 Gate&#xa;形成风险提醒或协同事项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F59E0B;fontColor=#7C4A03;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="430" y="650" width="310" height="115" as="geometry"/></mxCell>

        <mxCell id="c-task-q" value="对应子零件任务如何处理？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#134E4A;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="820" y="390" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="c-add" value="新增零件 / 二供同步开发&#xa;判断后创建或启动新任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#134E4A;" vertex="1" parent="c1"><mxGeometry x="800" y="650" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="c-delete" value="删除零件 / 二供删除&#xa;关闭或取消任务，保留历史&#xa;禁止物理删除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#134E4A;" vertex="1" parent="c1"><mxGeometry x="1090" y="650" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="c-replace" value="替换零件 / 一供变更&#xa;判断继承、部分重做、完全重做&#xa;重评供应商开发任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#134E4A;" vertex="1" parent="c1"><mxGeometry x="1380" y="650" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="c-minor" value="数量 / 层级 / 非关键文本属性&#xa;记录变更；按需通知或调整归属&#xa;默认不重建 APQP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#134E4A;" vertex="1" parent="c1"><mxGeometry x="800" y="790" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="c-spec" value="规格 / 图纸状态变化&#xa;触发影响分析&#xa;必要时重开相关任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#134E4A;" vertex="1" parent="c1"><mxGeometry x="1090" y="790" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="c-confirm" value="SCM 确认新版本&#xa;锁定生效 / 旧版本作废留存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#16324F;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="1380" y="790" width="270" height="105" as="geometry"/></mxCell>

        <mxCell id="c-audit" value="全链路审计追溯" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EEF2FF;strokeColor=#818CF8;fontColor=#3730A3;fontStyle=1;fontSize=16;" vertex="1" parent="c1"><mxGeometry x="80" y="880" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="c-audit-list" value="保留：BOM 版本、BOM 行变更、供应方案变化、APQP / 子零件任务生成、手动新增、任务关闭/继承/重做、影响分析、项目 Gate 审批判断、操作者与时间。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;fontColor=#4C1D95;align=left;spacingLeft=14;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="360" y="890" width="1290" height="90" as="geometry"/></mxCell>
        <mxCell id="c-rule" value="总原则：BOM 变化通过“版本差异 + 影响分析”驱动任务同步；不得直接破坏或物理删除已经生成的子零件开发任务。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F59E0B;fontColor=#7C4A03;fontStyle=1;fontSize=15;" vertex="1" parent="c1"><mxGeometry x="80" y="1020" width="1570" height="55" as="geometry"/></mxCell>

        <mxCell id="c-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="c1" source="c-trigger" target="c-new-version"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="c1" source="c-new-version" target="c-diff"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="c1" source="c-diff" target="c-types"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;" edge="1" parent="c1" source="c-types" target="c-impact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e5" value="项目级影响判断" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=block;fontColor=#B91C1C;" edge="1" parent="c1" source="c-impact" target="c-project-q"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e6" value="任务同步判断" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;fontColor=#047857;" edge="1" parent="c1" source="c-impact" target="c-task-q"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e7" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=block;fontColor=#B91C1C;" edge="1" parent="c1" source="c-project-q" target="c-project-block"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e8" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;fontColor=#B45309;" edge="1" parent="c1" source="c-project-q" target="c-sub-only"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;endArrow=block;" edge="1" parent="c1" source="c-task-q" target="c-add"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;endArrow=block;" edge="1" parent="c1" source="c-task-q" target="c-delete"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e11" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;endArrow=block;" edge="1" parent="c1" source="c-task-q" target="c-replace"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e12" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;endArrow=block;" edge="1" parent="c1" source="c-task-q" target="c-minor"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e13" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;endArrow=block;" edge="1" parent="c1" source="c-task-q" target="c-spec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e14" value="影响分析完成后提交确认" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;fontColor=#1D4ED8;" edge="1" parent="c1" source="c-spec" target="c-confirm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e15" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#818CF8;strokeWidth=2;endArrow=block;" edge="1" parent="c1" source="c-confirm" target="c-audit-list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e16" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#818CF8;strokeWidth=2;endArrow=block;" edge="1" parent="c1" source="c-audit" target="c-audit-list"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
